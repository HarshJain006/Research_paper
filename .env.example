# --- LLM provider (required for default "Groq" mode) ---
GROQ_API_KEY=
GROQ_TEXT_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=meta-llama/llama-4-scout-17b-16e-instruct

# --- Custom OpenAI-compatible provider fallback (used if selected in UI) ---
CUSTOM_API_KEY=
CUSTOM_VISION_MODEL=

# --- Research Agent: internet search (optional but recommended) ---
# Better quality, structured web search. Get a free key at tavily.com.
# If left blank, the Research Agent automatically falls back to scraping
# DuckDuckGo's no-JS HTML endpoint (no key needed, lower quality).
TAVILY_API_KEY=

# --- Research Agent: real MCP server (optional) ---
# Point this at any streamable-HTTP MCP server that exposes a web-search
# tool (e.g. a hosted Tavily/Exa/Brave MCP endpoint). If set, the Research
# Agent calls it over the actual MCP protocol instead of the REST fallback.
# Requires `pip install mcp` (already in requirements.txt).
MCP_SERVER_URL=
MCP_SEARCH_TOOL_NAME=

# Semantic Scholar + arXiv search need no API key/config — they're always on.

PORT=8000
